<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.strangerthings.ApproveController"
            prefHeight="400.0"
            prefWidth="600.0">

    <VBox spacing="15"
          alignment="CENTER"
          AnchorPane.topAnchor="30.0"
          AnchorPane.bottomAnchor="30.0"
          AnchorPane.leftAnchor="30.0"
          AnchorPane.rightAnchor="30.0">

        <Label text="Booking Details"/>
        <Label text="Resource: Example Resource"/>
        <Label text="Member: Example Member"/>
        <Label text="Date: Example Date"/>
        <Label text="Time: Example Time"/>
        <Label text="Status: Pending"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Approve"
                    onAction="#onApprove"/>

            <Button text="Reject"
                    onAction="#onReject"/>
        </HBox>
    </VBox>
</AnchorPane>