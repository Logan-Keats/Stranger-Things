<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns= "http://javafx.com/javafx"
            xmlns:fx= "http://javafx.com/fxml"
            fx:controller= "com.strangerthings.controller.ApproveController"
            stylesheets="@theme.css"
            styleClass="approve-root"
            prefWidth= "900.0"
            prefHeight= "600.0">

    <top>
        <VBox spacing= "8">
            <padding>
                <Insets top="30" right="30" bottom="20" left="30"/>
            </padding>
            <Label text="Booking Management" styleClass="page-title"/>
            <Label text="Review, approve, or reject member booking requests." styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="10" right="30" bottom="20" left="30"/>
            </padding>

            <Label
                    text="All Bookings"
                    styleClass="section-title"
            />

            <TableView fx:id="bookingTable"
                       prefHeight="350.0"
                       styleClass="booking-table"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="resourceColumn"
                                 text="Resource"
                                 prefWidth="160"/>

                    <TableColumn fx:id="borrowerColumn"
                                 text="Borrower"
                                 prefWidth="150"/>

                    <TableColumn fx:id="startDateColumn"
                                 text="Start Date"
                                 prefWidth="120"/>

                    <TableColumn fx:id="endDateColumn"
                                 text="End Date"
                                 prefWidth="120"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="120"/>

                </columns>
            </TableView>

            <HBox spacing="12">

                <Button text="Approve Booking"
                        prefWidth="150"
                        prefHeight="35"
                        onAction="#onApprove"
                        styleClass="btn-primary/>

                <Button text="Reject Booking"
                        prefWidth="150"
                        prefHeight="35"
                        onAction="#onReject"
                        styleClass="btn-danger"/>

                <Button text="View Details"
                        prefWidth="150"
                        prefHeight="35"
                        onAction="#onViewDetails"
                        styleClass="btn-secondary"/>

            </HBox>

            <Label fx:id="messageLabel"
                   text="Select a booking from the table."
                   wrapText="true"
                   styleClass="message-label"/>

        </VBox>
    </center>

</BorderPane>