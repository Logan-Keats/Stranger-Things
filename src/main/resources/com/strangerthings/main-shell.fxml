<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.strangerthings.MainShellController"
            prefHeight="400.0" prefWidth="600.0">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <padding><Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/></padding>
            <children>
                <Label text="Stranger Things"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="userNameLabel" text="User"/>
                <Button text="Logout" onAction="#onLogout"/>
            </children>
        </HBox>
    </top>
    <left>
        <VBox spacing="8.0">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>
            <children>
                <Button text="Home" maxWidth="Infinity" onAction="#onHome"/>
                <Button text="Resources" maxWidth="Infinity" onAction="#onResources"/>
                <Button text="My Bookings" maxWidth="Infinity" onAction="#onMyBookings"/>
                <Button fx:id="allBookingsButton" text="All Bookings" maxWidth="Infinity" onAction="#onAllBookings"/>
                <Button text="Booking Detail" maxWidth="Infinity" onAction="#onBookingDetail"/>
                <Button fx:id="reportsButton" text="Reports" maxWidth="Infinity" onAction="#onReports"/>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea">
            <children><Label text="Page content"/></children>
        </StackPane>
    </center>
</BorderPane>
