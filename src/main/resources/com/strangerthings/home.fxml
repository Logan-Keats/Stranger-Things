<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.strangerthings.HomeController" fitToWidth="true"
            style="-fx-background-color: #f7f3ea;">
    <content>
        <VBox spacing="16.0" style="-fx-background-color: #f7f3ea;">
            <padding><Insets top="22.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label fx:id="pageTitleLabel" text="Home Dashboard" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #153d12;"/>
                        <Label fx:id="pageSubtitleLabel" text="Community sharing overview" style="-fx-font-size: 13px; -fx-text-fill: #63705d;"/>
                    </children>
                </VBox>
                <VBox fx:id="memberDashboard" spacing="16.0">
                    <children>
                        <HBox spacing="12.0">
                            <children>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding><children><Label text="Items shared" style="-fx-text-fill: #63705d;"/><Label fx:id="totalSharedLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #153d12;"/></children></VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding><children><Label text="Items borrowed" style="-fx-text-fill: #63705d;"/><Label fx:id="totalBorrowedLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #153d12;"/></children></VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding><children><Label text="CO2 avoided" style="-fx-text-fill: #63705d;"/><Label fx:id="co2AvoidedLabel" text="0 kg" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #153d12;"/></children></VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding><children><Label text="Money saved" style="-fx-text-fill: #63705d;"/><Label fx:id="moneySavedLabel" text="0.00" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #153d12;"/></children></VBox>
                            </children>
                        </HBox>
                        <HBox spacing="16.0">
                            <children>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="16.0" right="18.0" bottom="18.0" left="18.0"/></padding><children><Label text="Community catalogue" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #263423;"/><PieChart fx:id="memberCategoryPieChart" prefHeight="260.0" legendVisible="true"/></children></VBox>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="16.0" right="18.0" bottom="18.0" left="18.0"/></padding><children><Label text="Recent activity" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #263423;"/><ListView fx:id="recentActivityList" prefHeight="260.0"/></children></VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox fx:id="adminDashboard" spacing="16.0">
                    <children>
                        <HBox spacing="12.0">
                            <children>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" onMouseClicked="#onShowMembers" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"><padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding><children><Label text="Total members" style="-fx-text-fill: #63705d;"/><Label fx:id="totalNumberLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #153d12;"/></children></VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding><children><Label text="Active listings" style="-fx-text-fill: #63705d;"/><Label fx:id="activeListingsLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #153d12;"/></children></VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding><children><Label text="Total borrowings" style="-fx-text-fill: #63705d;"/><Label fx:id="totalBorrowingsLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #153d12;"/></children></VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/></padding><children><Label text="Usage rate" style="-fx-text-fill: #63705d;"/><Label fx:id="usageRateLabel" text="0%" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #153d12;"/></children></VBox>
                            </children>
                        </HBox>
                        <HBox spacing="16.0">
                            <children>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="16.0" right="18.0" bottom="18.0" left="18.0"/></padding><children><Label text="Borrowing activity" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #263423;"/><BarChart fx:id="borrowingActivityChart" legendVisible="false" animated="false" prefHeight="260.0"><xAxis><CategoryAxis label="Date"/></xAxis><yAxis><NumberAxis label="Borrows" minorTickVisible="false" tickUnit="1.0"/></yAxis></BarChart></children></VBox>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="16.0" right="18.0" bottom="18.0" left="18.0"/></padding><children><Label text="Resource categories" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #263423;"/><PieChart fx:id="adminCategoryPieChart" prefHeight="260.0" legendVisible="true"/></children></VBox>
                            </children>
                        </HBox>
                        <VBox spacing="10.0" style="-fx-background-color: #fffdf7; -fx-border-color: #ded7c8; -fx-border-radius: 6; -fx-background-radius: 6;"><padding><Insets top="16.0" right="18.0" bottom="18.0" left="18.0"/></padding><children><Label text="Recent joins" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #263423;"/><ListView fx:id="recentJoinList" prefHeight="150.0"/></children></VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
