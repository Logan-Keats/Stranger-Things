<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.strangerthings.ReportsController" fitToWidth="true"
            style="-fx-background-color: #f3eee5;">
    <content>
        <VBox spacing="28.0" style="-fx-background-color: #f3eee5;">
            <padding><Insets top="28.0" right="30.0" bottom="30.0" left="30.0"/></padding>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label fx:id="reportsPageTitleLabel" text="Reports &amp; Audit" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #24201e;"/>
                        <Label text="Platform activity log and exportable reports" style="-fx-font-size: 14px; -fx-text-fill: #776f69;"/>
                    </children>
                </VBox>

                <VBox spacing="16.0">
                    <children>
                        <Label text="Export reports" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #302b28;"/>
                        <GridPane hgap="16.0" vgap="14.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0"/>
                                <ColumnConstraints percentWidth="50.0"/>
                            </columnConstraints>
                            <children>
                                <HBox GridPane.columnIndex="0" GridPane.rowIndex="0" alignment="CENTER_LEFT" spacing="14.0" minHeight="102.0" style="-fx-background-color: #fcfaf6; -fx-border-color: #d9cdb9; -fx-border-radius: 12; -fx-background-radius: 12;">
                                    <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/></padding>
                                    <children>
                                        <Label text="CSV" style="-fx-background-color: #ebe4d7; -fx-background-radius: 8; -fx-padding: 12 8 12 8; -fx-text-fill: #665e57; -fx-font-weight: bold;"/>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS"><children><Label text="Utilisation Report" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #24201e;"/><Label text="Resource usage rates and borrow frequency" style="-fx-text-fill: #776f69;"/><Label text="Aug 2026" style="-fx-font-size: 11px; -fx-text-fill: #a59b91;"/></children></VBox>
                                        <Button text="Export CSV" onAction="#onExportUsage" style="-fx-background-color: transparent; -fx-border-color: #d5c8b6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #625a54;"/>
                                    </children>
                                </HBox>
                                <HBox GridPane.columnIndex="1" GridPane.rowIndex="0" alignment="CENTER_LEFT" spacing="14.0" minHeight="102.0" style="-fx-background-color: #fcfaf6; -fx-border-color: #d9cdb9; -fx-border-radius: 12; -fx-background-radius: 12;">
                                    <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/></padding>
                                    <children>
                                        <Label text="CSV" style="-fx-background-color: #ebe4d7; -fx-background-radius: 8; -fx-padding: 12 8 12 8; -fx-text-fill: #665e57; -fx-font-weight: bold;"/>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS"><children><Label text="Member Activity" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #24201e;"/><Label text="Member sign-ups and borrowing patterns" style="-fx-text-fill: #776f69;"/><Label text="YTD 2026" style="-fx-font-size: 11px; -fx-text-fill: #a59b91;"/></children></VBox>
                                        <Button text="Export CSV" onAction="#onExportMemberActivity" style="-fx-background-color: transparent; -fx-border-color: #d5c8b6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #625a54;"/>
                                    </children>
                                </HBox>
                                <HBox GridPane.columnIndex="0" GridPane.rowIndex="1" alignment="CENTER_LEFT" spacing="14.0" minHeight="102.0" style="-fx-background-color: #fcfaf6; -fx-border-color: #d9cdb9; -fx-border-radius: 12; -fx-background-radius: 12;">
                                    <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/></padding>
                                    <children>
                                        <Label text="CSV" style="-fx-background-color: #ebe4d7; -fx-background-radius: 8; -fx-padding: 12 8 12 8; -fx-text-fill: #665e57; -fx-font-weight: bold;"/>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS"><children><Label text="Environmental Impact" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #24201e;"/><Label text="CO2 avoided, items saved from purchase" style="-fx-text-fill: #776f69;"/><Label text="YTD 2026" style="-fx-font-size: 11px; -fx-text-fill: #a59b91;"/></children></VBox>
                                        <Button text="Export CSV" onAction="#onExportCo2" style="-fx-background-color: transparent; -fx-border-color: #d5c8b6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #625a54;"/>
                                    </children>
                                </HBox>
                                <HBox GridPane.columnIndex="1" GridPane.rowIndex="1" alignment="CENTER_LEFT" spacing="14.0" minHeight="102.0" style="-fx-background-color: #fcfaf6; -fx-border-color: #d9cdb9; -fx-border-radius: 12; -fx-background-radius: 12;">
                                    <padding><Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/></padding>
                                    <children>
                                        <Label text="CSV" style="-fx-background-color: #ebe4d7; -fx-background-radius: 8; -fx-padding: 12 8 12 8; -fx-text-fill: #665e57; -fx-font-weight: bold;"/>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS"><children><Label text="Moderation Log" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #24201e;"/><Label text="Approvals, rejections, and flagged items" style="-fx-text-fill: #776f69;"/><Label text="Aug 2026" style="-fx-font-size: 11px; -fx-text-fill: #a59b91;"/></children></VBox>
                                        <Button text="Export CSV" onAction="#onExportModerationLog" style="-fx-background-color: transparent; -fx-border-color: #d5c8b6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #625a54;"/>
                                    </children>
                                </HBox>
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <VBox spacing="14.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Audit log" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #302b28;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="auditSearchField" promptText="Search..." prefWidth="210.0" style="-fx-background-color: #fcfaf6; -fx-border-color: #d9cdb9; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                                <ComboBox fx:id="auditTypeFilter" onAction="#onAuditTypeChanged" prefWidth="130.0" style="-fx-background-color: #fcfaf6; -fx-border-color: #d9cdb9; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                            </children>
                        </HBox>
                        <TableView fx:id="auditTable" prefHeight="420.0" style="-fx-background-color: #fcfaf6; -fx-border-color: #d9cdb9; -fx-border-radius: 12; -fx-background-radius: 12;">
                            <columns>
                                <TableColumn fx:id="actionColumn" text="ACTION" prefWidth="620.0"/>
                                <TableColumn fx:id="userColumn" text="USER" prefWidth="180.0"/>
                                <TableColumn fx:id="timeColumn" text="TIMESTAMP" prefWidth="180.0"/>
                            </columns>
                        </TableView>
                        <Label fx:id="exportStatusLabel" text="" style="-fx-text-fill: #776f69;"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
