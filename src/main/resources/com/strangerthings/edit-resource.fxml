<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.strangerthings.EditResourceController"
      prefHeight="600.0"
      prefWidth="700.0"
      spacing="5">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <!-- Page title -->
    <Label text="Edit Resource"
           style="-fx-font-size: 20px;
                  -fx-font-weight: bold;"/>

    <!-- Form and image -->
    <HBox spacing="40">

        <!-- Resource details -->
        <VBox spacing="10"
              prefWidth="350">

            <!-- Resource Name -->
            <VBox spacing="5">
                <Label text="Resource Name"/>

                <TextField fx:id="resourceNameField"
                           text="Mechanical Toolbox"
                           prefWidth="250"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="5">
                <Label text="Description"/>

                <TextArea fx:id="descriptionField"
                          text="This is a toolkit used for car repairs"
                          prefWidth="250"
                          prefRowCount="3"
                          wrapText="true"/>
            </VBox>

            <!-- Category -->
            <VBox spacing="5">
                <Label text="Category"/>

                <ComboBox fx:id="categoryBox"
                          promptText="Select category"
                          prefWidth="250"/>
            </VBox>

            <!-- Collection Method -->
            <VBox spacing="5">
                <Label text="Collection Method"/>

                <ComboBox fx:id="collectionMethodBox"
                          promptText="Select collection method"
                          prefWidth="250"/>
            </VBox>

        </VBox>

        <!-- Resource Image -->
        <VBox spacing="10"
              prefWidth="150"
              minWidth="150">

            <Label text="Resource Image"/>

            <Label text="[Image Preview]"
                   prefWidth="150"
                   prefHeight="150"
                   alignment="CENTER"
                   style="-fx-background-color: #2b2b2b;
                          -fx-text-fill: white;"/>

            <Button text="Upload Image"
                    prefWidth="200"
                    onAction="#onUploadImage"/>

        </VBox>

    </HBox>

    <!-- Validation message -->
    <Label fx:id="errorLabel"
           text=""
           wrapText="true"
           style="-fx-text-fill: red;"/>

    <!-- Bottom buttons -->
    <HBox spacing="50">

        <Button text="Cancel"
                onAction="#onCancel"/>

        <Button text="Save Changes"
                onAction="#onSaveChanges"/>

    </HBox>

</VBox>