<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.strangerthings.controller.BookingDetailController"
      stylesheets="@theme.css"
      styleClass="approve-root"
      spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Booking Details"
           styleClass="page-title"
    />

    <GridPane hgap="15" vgap="10">

        <Label text="Booking ID:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <Label fx:id="bookingIdLabel"
               GridPane.columnIndex="1"
               GridPane.rowIndex="0"/>

        <Label text="Resource:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <Label fx:id="resourceNameLabel"
               GridPane.columnIndex="1"
               GridPane.rowIndex="1"/>

        <Label text="Borrower:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <Label fx:id="borrowerNameLabel"
               GridPane.columnIndex="1"
               GridPane.rowIndex="2"/>

        <Label text="Status:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <Label fx:id="statusLabel"
               GridPane.columnIndex="1"
               GridPane.rowIndex="3"/>

    </GridPane>

    <Button fx:id="markOnLoanButton"
            text="Mark On Loan"
            onAction="#onMarkOnLoan"
            styleClass="btn-primary"/>

    <Button fx:id="markReturnedButton"
            text="Mark Returned"
            onAction="#onMarkReturned"
            styleClass="btn-secondary"/>

    <Label fx:id="messageLabel"
           wrapText="true"
           styleClass="message-label"/>

    <Label text="Resource Usage History"
           styleClass="section-title"/>

    <TableView fx:id="historyTable"
               prefHeight="220"
               styleClass="booking-table">

        <columns>

            <TableColumn fx:id="historyBorrowerColumn"
                         text="Borrower"
                         prefWidth="150"/>

            <TableColumn fx:id="historyStartDateColumn"
                         text="Start Date"
                         prefWidth="130"/>

            <TableColumn fx:id="historyEndDateColumn"
                         text="End Date"
                         prefWidth="130"/>

            <TableColumn fx:id="historyStatusColumn"
                         text="Status"
                         prefWidth="130"/>

        </columns>

    </TableView>

</VBox>