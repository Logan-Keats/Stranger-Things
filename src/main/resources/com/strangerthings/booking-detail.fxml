<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.strangerthings.controller.BookingDetailController"
      spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Booking Details"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="15" vgap="10">

        <Label text="Booking ID:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>
        <Label fx:id="bookingIdLabel"
               GridPane.columnIndex="1"
               GridPane.rowIndex="0"/>

        <Label text="Resource:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>
        <Label fx:id="resourceNameLabel"
               GridPane.columnIndex="1"
               GridPane.rowIndex="1"/>

        <Label text="Borrower:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>
        <Label fx:id="borrowerNameLabel"
               GridPane.columnIndex="1"
               GridPane.rowIndex="2"/>

        <Label text="Status:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>
        <Label fx:id="statusLabel"
               GridPane.columnIndex="1"
               GridPane.rowIndex="3"/>

    </GridPane>

    <Button fx:id="markOnLoanButton"
            text="Mark On Loan"
            onAction="#onMarkOnLoan"/>

    <Button fx:id="markReturnedButton"
            text="Mark Returned"
            onAction="#onMarkReturned"/>

    <Label fx:id="messageLabel"
           wrapText="true"
           style="-fx-font-size: 14px;"/>

</VBox>