<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.strangerthings.AddResourceController"
      prefHeight="600.0"
      prefWidth="700.0"
      spacing="20">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Register Resource"
           style="-fx-font-size: 20px;
                  -fx-font-weight: bold;"/>

    <HBox spacing="40">

        <!-- Resource details -->
        <VBox spacing="15" prefWidth="400">

            <VBox spacing="5">
                <Label text="Resource Name"/>
                <TextField fx:id="resourceNameField"
                           promptText="Enter resource name..."/>
            </VBox>

            <VBox spacing="5">
                <Label text="Description"/>
                <TextArea fx:id="descriptionField"
                          promptText="Enter resource description..."
                          prefRowCount="4"
                          wrapText="true"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Category"/>
                <ComboBox fx:id="categoryBox"
                          promptText="Select category"
                          prefWidth="400"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Collection Method"/>
                <ComboBox fx:id="collectionMethodBox"
                          promptText="Select collection method"
                          prefWidth="400"/>
            </VBox>

        </VBox>

        <!-- Resource Image -->
        <VBox spacing="10" prefWidth="200">

            <Label text="Resource Image"/>

            <Label text="[Image Preview]"
                   prefWidth="200"
                   prefHeight="200"
                   alignment="CENTER"
                   style="-fx-background-color: #2b2b2b;
                          -fx-text-fill: white;"/>

            <Button text="Upload Image"
                    prefWidth="200"
                    onAction="#onUploadImage"/>

        </VBox>

    </HBox>

    <!-- Validation message -->
    <Label fx:id="errorLabel"
           text=""
           wrapText="true"
           style="-fx-text-fill: red;"/>

    <!-- Buttons -->
    <HBox spacing="10">

        <Button text="Cancel"
                onAction="#onCancel"/>

        <Button text="Register Resource"
                onAction="#onRegisterResource"/>

    </HBox>

</VBox>